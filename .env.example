# --- VentureLens configuration ---------------------------------------------
# All values are server-side environment variables. Never commit a real secret.

# Runtime
VL_DEBUG=0
VL_APP_NAME=VentureLens
VL_TAGLINE="A clearer view of where to grow."

# Always set a strong random value before public deployment.
VL_SECRET_KEY=dev-secret-change-me

# Sessions
VL_SESSION_MAX_AGE_SECONDS=3600
VL_SESSION_COOKIE_NAME=vl_session
# Enable when serving over HTTPS.
VL_COOKIE_SECURE=0
VL_COOKIE_SAMESITE=lax

# Public-demo safety limits
VL_RATE_LIMIT_PER_IP=120
VL_RATE_LIMIT_WINDOW_SECONDS=60
VL_SESSION_QUERY_BUDGET=30
VL_GLOBAL_QUERY_BUDGET=200000
VL_REQUEST_MAX_BYTES=1048576

# Comma-separated proxy IPs/addresses whose X-Forwarded-For header is trusted.
TL_TRUSTED_X_FORWARDED=0
VL_TRUSTED_PROXIES=

# Origin allowlist for state-changing requests (CSRF defense).
VL_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Provider timeouts (bounded costs and latency)
VL_SEARCH_TIMEOUT_SECONDS=20
VL_QLOO_TIMEOUT_SECONDS=20
VL_LLM_TIMEOUT_SECONDS=60

# Provider selection. "demo" runs with no credentials and is fully testable.
VL_PROVIDER=demo

# Optional real-provider credentials (adapter seams; demo ignores these).
VL_LLM_API_KEY=
VL_LLM_PROVIDER=
VL_LLM_MODEL=
VL_SEARCH_API_KEY=
VL_SEARCH_PROVIDER=
VL_QLOO_API_KEY=
VL_QLOO_BASE_URL=https://api.qloo.com