# Server-side only. Never commit a real secret. Copy to .env and fill the live values there.

# demo  — no credentials, deterministic questions and brief
# live  — Qloo taste signals, then an OpenAI-compatible model writes the brief
VL_PROVIDER=demo

# Required before a public deployment.
VL_SECRET_KEY=dev-secret-change-me

# Sessions
VL_SESSION_MAX_AGE_SECONDS=3600
VL_SESSION_COOKIE_NAME=vl_session
# Set to 1 when serving over HTTPS.
VL_COOKIE_SECURE=0
VL_COOKIE_SAMESITE=lax

# Safety limits
VL_RATE_LIMIT_PER_IP=120
VL_RATE_LIMIT_WINDOW_SECONDS=60
VL_SESSION_QUERY_BUDGET=30
VL_GLOBAL_QUERY_BUDGET=200000
# Comma-separated proxy addresses whose X-Forwarded-For is trusted. Empty = ignore the header.
VL_TRUSTED_PROXIES=
VL_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Display
VL_APP_NAME=VentureLens
VL_TAGLINE=A clearer view of where to grow.

# Live provider. Ignored while VL_PROVIDER=demo.
# Hackathon keys only work on this host.
VL_QLOO_API_KEY=
VL_QLOO_BASE_URL=https://hackathon.api.qloo.com
VL_QLOO_TIMEOUT_SECONDS=20

# OpenAI host by default. Also: openrouter, groq, together.
# Set VL_LLM_BASE_URL only to override that host.
# GPT-6 Luna is the brief writer: model id gpt-6-luna.
VL_LLM_API_KEY=
VL_LLM_PROVIDER=openai
VL_LLM_MODEL=gpt-6-luna
VL_LLM_BASE_URL=
VL_LLM_TIMEOUT_SECONDS=60
